{
  "name": "duokit",
  "version": "0.1.0",
  "description": "Make web apps fold-aware on iPhone Duo (and other foldables), plus an open reconstruction of the Duo's unfold animation.",
  "license": "MIT",
  "homepage": "https://arjunkshah12345-hash.github.io/duokit/",
  "bugs": {
    "url": "https://github.com/arjunkshah12345-hash/duokit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "duo.css",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./duo.css": "./duo.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format esm,cjs --clean --external react && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite demo",
    "demo:build": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "fixtures": "tsx scripts/fixtures.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "iphone duo",
    "foldable",
    "device posture",
    "viewport segments",
    "fold",
    "hinge",
    "webgl",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arjunkshah12345-hash/duokit.git",
    "directory": "web"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
